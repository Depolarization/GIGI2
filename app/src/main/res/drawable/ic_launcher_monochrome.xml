        android:fillColor="#FFFFFFFF"
        android:pathData="M50,26 L55.07,41.03 L70.78,43.07 L58.39,55.11 L61.07,71.72 L50,63.77 L38.93,71.72 L41.61,55.11 L29.22,43.07 L44.93,41.03 Z" />
    <path
        android:fillColor="#FFFFFFFF"
