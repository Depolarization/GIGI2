    <!-- About dialog -->
    <string name="about_title">About</string>
    <string name="about_section_software">About This App</string>
    <string name="about_fact_project">Project</string>
    <string name="about_value_project">GIGI (Genshin Impact Genius Invokation TCG Tool)</string>
    <string name="about_fact_form">Form</string>
    <string name="about_value_form">Native Android app — install and go; sign in with a QR code via HoYoLAB or Cloud·Genshin</string>
    <string name="about_section_tips">Usage Tips</string>
    <string name="about_tip_delay">Like the wish history, new match data arrives with some delay; if the latest record is not there yet, try again shortly.</string>
    <string name="about_tip_restart">In a hurry to refresh, exit to the main menu (the door screen) and re-enter to speed up data updates.</string>
    <string name="about_tip_recent">Match lookup on Home shows details for up to the last 10 matches; tap any row to see the opponent.</string>
    <string name="about_tip_uid_query">The player lookup in the top bar takes a UID and shows the TCG info of that player.</string>
    <string name="about_tip_multi_account">A newly scanned account is added to the local account list; the accounts already stored on this device are not lost.</string>
    <string name="about_tip_sunset">The tournament has shut down, so the tournament section may not stay valid long.</string>
    <string name="about_section_data">Data Sources &amp; Permissions</string>
    <string name="about_data_statement">Card image downloads come from public APIs and contain no personal match records; card usage details require login credentials.</string>
    <string name="about_data_bullet_source">All info comes from Genius Invokation tournaments and HoYoLAB; card data and images come from the HoYoLAB TCG Wiki.</string>
    <string name="about_data_bullet_credential">Credentials are stored only in the encrypted keystore on this device and are never uploaded to any server.</string>
    <string name="about_data_bullet_qr">The QR code is issued by the HoYoverse Pass; once you confirm, the credential exchange runs automatically on the server you selected.</string>
    <string name="about_section_thanks">How It Works &amp; Credits</string>
    <string name="about_thanks_intro">The original idea of looking up opponents via the official tournament site: </string>
    <string name="about_thanks_link">Bilibili explainer video</string>
    <string name="about_thanks_period">.</string>
    <string name="about_thanks_body">Built on public HoYoLAB APIs and official tournament data. Thanks to every community contributor who shared public data and API research.</string>
    <string name="about_section_feedback">Feedback</string>
    <string name="about_feedback_hint">If you run into any errors while using the app, feedback is welcome.</string>
