<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      API 31+ 原生启动屏（platform 属性，不依赖 androidx.core:core-splashscreen）。
      限定符目录不跨目录继承：本文件会整体替换 values/themes.xml 的同名 style，
      所以系统栏那几项必须在这里重写一遍。
    -->
    <style name="Theme.GIGI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <!-- V39-T：见 values/themes.xml，禁用系统强制深色对已知色板的二次改写 -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
